# Optional real-LLM path for the Ask-the-Wiki panel.
# Leave unset (default) to stay in mock/retrieval mode — no key required.
#
# If set, the Ask-the-Wiki panel will call the OpenAI-compatible Chat
# Completions API client-side with the retrieved wiki context as grounding.
# This is a LOCAL DEMO convenience only — a client-exposed key is NOT safe
# for any deployed/shared build. See README.md "Optional real-LLM path".
VITE_OPENAI_API_KEY=
VITE_OPENAI_MODEL=gpt-4o-mini
VITE_OPENAI_BASE_URL=https://api.openai.com/v1
